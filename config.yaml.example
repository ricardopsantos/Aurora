# Aurora config — machine-neutral template. Copy to config.yaml and adjust
# for your own setup. Keys come from the keystore (env var → OS keyring →
# encrypted file → prompt); never put them here.

providers:
  openrouter:
    type: openai
    base_url: https://openrouter.ai/api/v1
    api_key_env: OPENROUTER_API_KEY
  local:
    type: openai
    # `base_url` can be a single endpoint OR a list; Aurora tries them in
    # order and uses the first one that responds. Useful if your local
    # llama.cpp server is reachable both over LAN and a VPN/tailnet.
    base_url: http://localhost:8080/v1
    api_key_env: LLAMA_API_KEY   # unset/blank if your server needs no key

# first entry = the model Aurora starts on
models:
  - provider: local
    model: local            # whatever your local server currently has loaded
    tools: true
  - provider: openrouter
    model: moonshotai/kimi-k2.7-code
    tools: true

runtime:
  max_iterations: 10
  web_search: true
  timeout: 300
  # R58: scan prompts + tool output for likely secrets (API keys, tokens,
  # .env-style credentials) and challenge before sending/logging. /redact
  # on|off toggles + persists here.
  redact_secrets: true
  # R91: mark the system prompt as cacheable (cache_control breakpoint) so
  # the bootstrap preamble isn't re-billed on every tool iteration of every
  # turn. Per-model default: on for remote models, off for `model: local`
  # (llama.cpp keeps its own prefix cache); a model entry's `cache: true`
  # /`false` overrides. /cache on|off toggles + persists here, /cost shows
  # the hits.
  prompt_cache: true
  # R94: run a round's read-only tool calls (reads/greps/fetches) at once
  # instead of one after another. Approvals and output order are unaffected.
  parallel_tools: true
  # R118: silently fold OLDER history into a summary once context usage
  # crosses auto_compact_threshold_pct — recent turns (the last
  # ~compact_keep_recent_tokens tokens) stay raw, unlike manual /compact
  # (which always folds everything). /autocompact on|off toggles + persists
  # here.
  # R154: ON by default, at 80%, and checked BETWEEN ROUNDS of a running
  # turn as well as at the end of one. End-of-turn-only could not save the
  # long tool-heavy turn that overflows the window, because that turn never
  # reaches the end-of-turn check. Set false to go back to doing it by hand
  # with /compact.
  auto_compact: true
  auto_compact_threshold_pct: 80
  compact_keep_recent_tokens: 20000

# R119: MCP (Model Context Protocol) servers, stdio transport only. Each
# server's tools are exposed to the model as mcp_<name>_<tool>, gated by the
# SAME approval prompt as write_file/run_command — every MCP call needs
# approval, no "trusted server" bypass. `env` maps a CHILD process env var
# name to an AURORA keystore env var name (`aurora key set <name>`) — never
# put a raw token here.
# mcp_servers:
#   - name: filesystem
#     command: npx
#     args: ["-y", "@modelcontextprotocol/server-filesystem", "/path/to/allow"]
#   - name: github
#     command: npx
#     args: ["-y", "@modelcontextprotocol/server-github"]
#     env: {GITHUB_PERSONAL_ACCESS_TOKEN: GITHUB_TOKEN}

# `aurora key set <VAR>` offers to run these (shown first, needs a "y") and
# stores the printed value in the keystore. No secret lives in this file.
# Example: fetch a key from a remote box over ssh instead of typing it in —
# key_fetch:
#   LLAMA_API_KEY: ssh myhost "grep '^LLAMA_API_KEY=' /etc/environment | cut -d= -f2-"
