# Aurora config — machine-neutral template. Copy to config.yaml and adjust
# for your own setup. Keys come from the keystore (env var → OS keyring →
# encrypted file → prompt); never put them here.

providers:
  openrouter:
    type: openai
    base_url: https://openrouter.ai/api/v1
    api_key_env: OPENROUTER_API_KEY
  local:
    type: openai
    # `base_url` can be a single endpoint OR a list; Aurora tries them in
    # order and uses the first one that responds. Useful if your local
    # llama.cpp server is reachable both over LAN and a VPN.
    base_url: http://localhost:8080/v1
    api_key_env: LLAMA_API_KEY   # unset/blank if your server needs no key
  # R223: Ollama needs `type: ollama`, not `type: openai` — its chat API is
  # OpenAI-compatible (streaming, tool calls, all work through the same
  # code path as `local` above), but its reachability check and live
  # context-window lookup use Ollama's own routes (no /props, unlike
  # llama.cpp). No key needed; omit api_key_env entirely.
  ollama:
    type: ollama
    base_url: http://localhost:11434/v1

# first entry = the default for -t, piped input and --web; the terminal asks
# you to pick a model the first time (R578) and remembers it
models:
  - provider: local
    model: local            # whatever your local server currently has loaded
    tools: true
  - provider: ollama
    # must match `ollama list`'s NAME:TAG exactly. Ollama can mark a model
    # tools-capable that never emits a structured tool call (qwen2.5-coder:3b
    # printed the call as plain JSON text); the Qwen3 family emits real ones,
    # so prefer it for an Ollama backend Aurora will use tools with.
    model: qwen3:1.7b
    tools: true
  - provider: openrouter
    model: moonshotai/kimi-k2.7-code
    tools: true

runtime:
  # R508 (Aurora 2.0): which agent loop runs each turn. `rust` (the default)
  # uses the `aurora-rs` core that install.sh builds; `python` keeps the
  # Python loop. Without `aurora-rs` Aurora uses the Python loop anyway
  # (looked up as AURORA_RS, then PATH, then target/release, then target/debug).
  # The AURORA_CORE environment variable overrides this. Setting `rust`
  # explicitly also shows a notice whenever a turn falls back to Python.
  # core: python
  max_iterations: 10
  web_search: true
  timeout: 300
  # R58: scan prompts + tool output for likely secrets (API keys, tokens,
  # .env-style credentials) and challenge before sending/logging. /redact
  # on|off toggles + persists here.
  redact_secrets: true
  # R91: mark the system prompt as cacheable (cache_control breakpoint) so
  # the bootstrap preamble isn't re-billed on every tool iteration of every
  # turn. Per-model default: on for remote models, off for `model: local`
  # (llama.cpp keeps its own prefix cache); a model entry's `cache: true`
  # /`false` overrides. /cache on|off toggles + persists here, /cost shows
  # the hits.
  prompt_cache: true
  # R94: run a round's read-only tool calls (reads/greps/fetches) at once
  # instead of one after another. Approvals and output order are unaffected.
  parallel_tools: true
  # R118: silently fold OLDER history into a summary once context usage
  # crosses auto_compact_threshold_pct — recent turns (the last
  # ~compact_keep_recent_tokens tokens) stay raw, unlike manual /compact
  # (which always folds everything). /autocompact on|off toggles + persists
  # here.
  # R154: ON by default, at 80%, and checked BETWEEN ROUNDS of a running
  # turn as well as at the end of one. End-of-turn-only could not save the
  # long tool-heavy turn that overflows the window, because that turn never
  # reaches the end-of-turn check. Set false to go back to doing it by hand
  # with /compact.
  auto_compact: true
  auto_compact_threshold_pct: 80
  compact_keep_recent_tokens: 20000
  # Daily spending cap in USD across remote models; 0 = no cap. /budget sets it.
  daily_budget_usd: 0
  # Switch to the next model in `models:` when the current one fails.
  # /fallback on|off toggles + persists here.
  model_fallback: false
  # Enter inserts a newline and Alt+Enter submits. /multiline toggles + persists.
  multiline: false
  # Render replies as Markdown in the terminal.
  render_markdown: true
  # Show the model's reasoning as it streams.
  show_thinking: false
  # SHA-256 hashes of secret-scan hits you chose to allow. Managed by
  # `/redact allowlist [clear]`; never put the secrets themselves here.
  secret_allowlist: []
  # R475: run the model's shell commands in a sandbox (bubblewrap on Linux,
  # sandbox-exec on macOS): the machine read-only apart from the workspace,
  # Aurora's workspace/ folder, ~/.cache and a private /tmp; ssh keys,
  # credentials, Aurora's keys, the Docker socket and the user's D-Bus hidden.
  # web: the web page's commands (default); all: the terminal's too; off.
  # Commands you type in bash mode are never sandboxed.
  sandbox: web
  # false: no network inside the sandbox at all.
  sandbox_network: true
  # More folders the sandbox may write, e.g. [~/repositories].
  sandbox_writable: []
  # More files or folders it must not see, e.g. [~/.config/my-app].
  sandbox_hide: []

# R119: MCP (Model Context Protocol) servers, stdio transport only. Each
# server's tools are exposed to the model as mcp_<name>_<tool>, gated by the
# SAME approval prompt as write_file/run_command — every MCP call needs
# approval, no "trusted server" bypass. `env` maps a CHILD process env var
# name to an AURORA keystore env var name (`aurora key set <name>`) — never
# put a raw token here.
#
# `name` must be unique — it prefixes every tool as mcp_<name>_<tool>, so a
# repeated name is refused (R187b).
#
# `timeout` (seconds, default 15) is the per-request ceiling. Raise it for a
# server that shells out to real work: crossing it KILLS the child and there
# is no reconnect, so that server is gone for the rest of the session. The
# agentic-context example below sets 45 because its scripts allow themselves
# 30s, and a client ceiling under the server's own would make a large
# instance unusable rather than merely slow (R187c).
# mcp_servers:
#   - name: filesystem
#     command: npx
#     args: ["-y", "@modelcontextprotocol/server-filesystem", "/path/to/allow"]
#   - name: github
#     command: npx
#     args: ["-y", "@modelcontextprotocol/server-github"]
#     env: {GITHUB_PERSONAL_ACCESS_TOKEN: GITHUB_TOKEN}
#   - name: agentic-context
#     command: /path/to/AgenticContext/mcp_server/.venv/bin/python
#     args: ["-m", "agentic_context_mcp.server", "/path/to/.agentic_context"]
#     timeout: 45
#   - name: memory          # only the tools you list are shown to the model (R449);
#     command: /path/to/memory-server   # leave `tools:` out to expose them all
#     tools: [remember, recall]
#   - name: mnemosyne      # optional episodic memory, see documents/MCP_SERVERS.md
#     command: /path/to/mnemosyne-venv/bin/mnemosyne
#     args: ["mcp"]
#     timeout: 90
#     tools: [mnemosyne_remember, mnemosyne_recall, mnemosyne_get, mnemosyne_forget]

# `aurora key set <VAR>` offers to run these (shown first, needs a "y") and
# stores the printed value in the keystore. No secret lives in this file.
# Example: fetch a key from a remote box over ssh instead of typing it in —
# key_fetch:
#   LLAMA_API_KEY: ssh myhost "grep '^LLAMA_API_KEY=' /etc/environment | cut -d= -f2-"
