# GitHub/Aurora (public mirror) — regenerated by scripts/github-deploy.sh,
# hand edits here will be overwritten on the next deploy. Edit
# scripts/github-deploy.gitignore in GitTea/Aurora instead.
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
sessions/
.DS_Store
config.yaml
# private cross-session context tooling — excluded from the rsync
# too (github-deploy.sh); listed here so a miss there cannot be
# committed by accident. Renamed from .agentic_context/ in 5b260a2.
.agentic_context/
.context/
